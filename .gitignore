moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h

# Arquivos compilados
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe

# Arquivos temporários do sistema e editores
.DS_Store
Thumbs.db
*~
