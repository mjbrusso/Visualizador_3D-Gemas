          <widget class="QWidget" name="Sobre">
           <attribute name="title">
            <string>Projeto 3D gemas</string>
           </attribute>
           <layout class="QGridLayout">
            <item row="0" column="0">
             <widget class="QTextEdit" name="textEdit">
